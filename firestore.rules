rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Teacher access is intentionally allowlisted here as well as in the client.
    // Firebase Security Rules are the enforcement boundary; client checks are not.
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isTeacher() {
      return isAuthenticated()
        && request.auth.token.email in [
          'aymankareem548@gmail.com',
          'mariam@masria.academy'
        ];
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isStudent() {
      return isAuthenticated() && currentUser().data.role == 'student';
    }

    function isParent() {
      return isAuthenticated() && currentUser().data.role == 'parent';
    }

    function isActiveLearner() {
      return isAuthenticated()
        && currentUser().data.status == 'active'
        && currentUser().data.role in ['student', 'parent'];
    }

    // Parent documents should maintain this normalized array alongside the
    // display-oriented linkedStudents array: ['studentUid1', 'studentUid2'].
    function isLinkedParent(studentId) {
      return isParent()
        && studentId in (
          currentUser().data.keys().hasAny(['linkedStudentIds'])
            ? currentUser().data.linkedStudentIds
            : []
        );
    }

    function isValidParentLinkUpdate() {
      return isParent()
        && request.resource.data.linkedStudentIds.size() == (
          resource.data.keys().hasAny(['linkedStudentIds'])
            ? resource.data.linkedStudentIds.size()
            : 0
        ) + 1
        && request.resource.data.linkedStudentIds.hasAll(
          resource.data.keys().hasAny(['linkedStudentIds'])
            ? resource.data.linkedStudentIds
            : []
        )
        && (!resource.data.keys().hasAny(['lastLinkedCode'])
          || request.resource.data.lastLinkedCode != resource.data.lastLinkedCode)
        && getAfter(/databases/$(database)/documents/linkCodes/$(request.resource.data.lastLinkedCode)).data.active == false
        && getAfter(/databases/$(database)/documents/linkCodes/$(request.resource.data.lastLinkedCode)).data.linkedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/linkCodes/$(request.resource.data.lastLinkedCode)).data.studentId in request.resource.data.linkedStudentIds;
    }

    // A parent starts with no relationships. Student IDs may only be added by
    // isValidParentLinkUpdate(), which atomically claims a valid link code.
    function hasNoParentLinksOnCreate() {
      return (!request.resource.data.keys().hasAny(['linkedStudentIds'])
          || request.resource.data.linkedStudentIds.size() == 0)
        && (!request.resource.data.keys().hasAny(['linkedStudents'])
          || request.resource.data.linkedStudents.size() == 0)
        && !request.resource.data.keys().hasAny(['lastLinkedCode']);
    }

    function hasNoPackageEntitlementsOnCreate() {
      return (!request.resource.data.keys().hasAny(['accessiblePackageIds'])
          || (request.resource.data.accessiblePackageIds is list
            && request.resource.data.accessiblePackageIds.size() == 0))
        && !request.resource.data.keys().hasAny(['lastRedeemedAccessCode']);
    }

    function canReadStudentRecord(studentId) {
      return isTeacher()
        || (isStudent() && isOwner(studentId))
        || isLinkedParent(studentId);
    }

    function hasPackageOwnership(packageId) {
      let accessPath = /databases/$(database)/documents/studentPackageAccess/$(request.auth.uid + '_' + packageId);
      return isStudent()
        && exists(accessPath)
        && get(accessPath).data.studentId == request.auth.uid
        && get(accessPath).data.packageId == packageId
        && get(accessPath).data.status == 'active';
    }

    function packageEntitlementRemovedAfterWrite(studentId, packageId) {
      let studentPath = /databases/$(database)/documents/users/$(studentId);
      return exists(studentPath)
        && getAfter(studentPath).data.accessiblePackageIds is list
        && !(packageId in getAfter(studentPath).data.accessiblePackageIds);
    }

    function packageContainsLesson(packageId, lessonId) {
      let packagePath = /databases/$(database)/documents/coursePackages/$(packageId);
      return exists(packagePath)
        && get(packagePath).data.gradeLevel == resource.data.gradeLevel
        && get(packagePath).data.lessonIds is list
        && get(packagePath).data.lessonIds.hasAny([lessonId]);
    }

    function isUnbundledLesson(lessonData) {
      return lessonData.packageId == null
        && !lessonData.keys().hasAny(['packageIds']);
    }

    function hasOwnedPackageLessonReference(lessonData) {
      let lessonPackageIds = lessonData.keys().hasAny(['packageIds'])
        ? lessonData.packageIds
        : [];
      let accessiblePackageIds = currentUser().data.keys().hasAny(['accessiblePackageIds'])
        ? currentUser().data.accessiblePackageIds
        : [];
      return isStudent()
        && lessonPackageIds is list
        && accessiblePackageIds is list
        && lessonPackageIds.hasAny(accessiblePackageIds);
    }

    function canStudentAccessPublishedLesson(lessonId) {
      let lessonPath = /databases/$(database)/documents/lessons/$(lessonId);
      let lessonData = get(lessonPath).data;
      return exists(lessonPath)
        && isStudent()
        && currentUser().data.status == 'active'
        && lessonData.isPublished == true
        && lessonData.gradeLevel == currentUser().data.gradeLevel
        && (isUnbundledLesson(lessonData)
          || (lessonData.packageId is string
            && hasPackageOwnership(lessonData.packageId)
            && packageContainsLesson(lessonData.packageId, lessonId))
          || hasOwnedPackageLessonReference(lessonData));
    }

    function isValidPackageRedemption(userId) {
      let oldPackageIds = resource.data.keys().hasAny(['accessiblePackageIds'])
        ? resource.data.accessiblePackageIds
        : [];
      let newPackageIds = request.resource.data.accessiblePackageIds;
      let codeId = request.resource.data.lastRedeemedAccessCode;
      let accessCode = getAfter(/databases/$(database)/documents/packageAccessCodes/$(codeId)).data;
      let coursePackage = getAfter(/databases/$(database)/documents/coursePackages/$(accessCode.packageId)).data;

      return isStudent()
        && isOwner(userId)
        && currentUser().data.status == 'active'
        && request.resource.data.keys().hasAll(['accessiblePackageIds', 'lastRedeemedAccessCode'])
        && (!resource.data.keys().hasAny(['lastRedeemedAccessCode'])
          || request.resource.data.lastRedeemedAccessCode != resource.data.lastRedeemedAccessCode)
        && newPackageIds is list
        && newPackageIds.size() == oldPackageIds.size() + 1
        && newPackageIds.hasAll(oldPackageIds)
        && accessCode.usedBy == request.auth.uid
        && accessCode.packageId in newPackageIds
        && !(accessCode.packageId in oldPackageIds)
        && coursePackage.isActive == true
        && coursePackage.gradeLevel == currentUser().data.gradeLevel;
    }

    match /users/{userId} {
      allow read: if isAuthenticated()
        && (isOwner(userId) || isTeacher() || isLinkedParent(userId));

      // Signup creates the profile immediately after Firebase Auth succeeds.
      allow create: if isOwner(userId)
        && ((isTeacher()
          && request.resource.data.role == 'student'
          && request.resource.data.status == 'active'
          && hasNoPackageEntitlementsOnCreate())
        || (!isTeacher()
          && request.resource.data.role == 'student'
          && request.resource.data.status == 'active'
          && hasNoPackageEntitlementsOnCreate())
        || (!isTeacher()
          && request.resource.data.role == 'parent'
          && request.resource.data.status == 'active'
          && hasNoParentLinksOnCreate()));

      // Owners may update profile data such as completedLessons, but cannot
      // promote themselves, change role, or bypass approval status.
      allow update: if (isTeacher()
          && resource.data.role == 'student'
          && request.resource.data.role == resource.data.role)
        || (isOwner(userId)
          && request.resource.data.role == resource.data.role
          && (request.resource.data.status == resource.data.status
            || (resource.data.role == 'student'
              && resource.data.status == 'pending'
              && request.resource.data.status == 'active'))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['accessiblePackageIds', 'lastRedeemedAccessCode'])
            || isValidPackageRedemption(userId))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['linkedStudentIds', 'lastLinkedCode'])
            || isValidParentLinkUpdate()));

      allow delete: if isTeacher() && resource.data.role == 'student';
    }

    match /lessons/{lessonId} {
      allow get: if isTeacher()
        || (isActiveLearner()
          && resource.data.isPublished == true
          && (isParent()
            || currentUser().data.gradeLevel == resource.data.gradeLevel)
          && (isUnbundledLesson(resource.data)
            || (resource.data.packageId is string
              && hasPackageOwnership(resource.data.packageId)
              && packageContainsLesson(resource.data.packageId, lessonId))
            || hasOwnedPackageLessonReference(resource.data)));
      allow list: if isTeacher()
        || (isStudent()
          && currentUser().data.status == 'active'
          && resource.data.isPublished == true
          && resource.data.gradeLevel == currentUser().data.gradeLevel
          && resource.data.packageId == null);
      allow create, update, delete: if isTeacher();
    }

    match /exams/{examId} {
      allow read: if isTeacher()
        || (isActiveLearner()
          && currentUser().data.gradeLevel == resource.data.gradeLevel);
      allow create, update, delete: if isTeacher();
    }

    match /exam_results/{resultId} {
      allow read: if canReadStudentRecord(resource.data.studentId);
      allow create, update: if isTeacher();
      allow delete: if isTeacher();
    }

    match /performance/{performanceId} {
      allow read: if canReadStudentRecord(resource.data.studentId);

      allow create: if isStudent()
        && currentUser().data.status == 'active'
        && request.resource.data.studentId == request.auth.uid;

      allow update: if isTeacher();

      allow delete: if isTeacher();
    }

    match /announcements/{announcementId} {
      allow read: if isTeacher() || isActiveLearner();
      allow create, update, delete: if isTeacher();
    }

    match /linkCodes/{linkCode} {
      allow read: if isTeacher()
        || (isParent() && (resource.data.active == true || resource.data.linkedBy == request.auth.uid));

      allow create: if isAuthenticated()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';

      allow update: if isTeacher()
        || (isParent()
          && resource.data.active == true
          && request.resource.data.active == false
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.linkedBy == request.auth.uid
          && request.resource.data.createdAt == resource.data.createdAt);

      allow delete: if isTeacher();
    }

    function isSupportedProgrammingLanguage(language) {
      return language in ['cpp17', 'python3', 'java17', 'javascript-node'];
    }

    // Student-created submissions are source-only. Authoritative verdicts, scores,
    // mastery, and evaluator metadata belong in coding_evaluations / progress.
    function isValidStudentCodingSubmission() {
      return request.resource.data.keys().hasAll([
          'studentId',
          'lessonId',
          'activityId',
          'challengeVersion',
          'language',
          'sourceCode',
          'status',
          'submittedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'studentId',
          'lessonId',
          'activityId',
          'challengeVersion',
          'language',
          'sourceCode',
          'status',
          'submittedAt',
          'idempotencyKey'
        ])
        && !request.resource.data.keys().hasAny([
          'verdict',
          'scorePercent',
          'passed',
          'mastery',
          'passedTestCount',
          'totalTestCount',
          'publicTestResults',
          'evaluatorVersion',
          'evaluatedAt',
          'executionTimeMs',
          'memoryUsedKb',
          'feedback_en',
          'feedback_ar'
        ])
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.lessonId is string
        && request.resource.data.lessonId.size() > 0
        && request.resource.data.activityId is string
        && request.resource.data.activityId.size() > 0
        && request.resource.data.challengeVersion is int
        && request.resource.data.challengeVersion > 0
        && isSupportedProgrammingLanguage(request.resource.data.language)
        && request.resource.data.sourceCode is string
        && request.resource.data.sourceCode.size() > 0
        && request.resource.data.sourceCode.size() <= 100000
        && request.resource.data.status == 'queued'
        && request.resource.data.submittedAt is string
        && request.resource.data.submittedAt.size() > 0
        && canStudentAccessPublishedLesson(request.resource.data.lessonId)
        && (!request.resource.data.keys().hasAny(['id'])
          || (request.resource.data.id is string && request.resource.data.id.size() > 0))
        && (!request.resource.data.keys().hasAny(['idempotencyKey'])
          || (request.resource.data.idempotencyKey is string
            && request.resource.data.idempotencyKey.size() > 0
            && request.resource.data.idempotencyKey.size() <= 256));
    }

    // ============================================================================
    // CODING SUBMISSIONS
    // ============================================================================
    // Students may create their own source-only submissions. Documents are
    // immutable after create. Status/result writes are reserved for a future
    // trusted execution service (Admin SDK / service account).
    match /coding_submissions/{submissionId} {
      allow read: if canReadStudentRecord(resource.data.studentId);

      allow create: if isStudent()
        && currentUser().data.status == 'active'
        && isValidStudentCodingSubmission();

      allow update, delete: if false;
    }

    // ============================================================================
    // CODING EVALUATIONS
    // ============================================================================
    // Only the trusted execution service can create evaluations.
    // Students cannot create or update evaluations to prevent result forgery.
    match /coding_evaluations/{evaluationId} {
      allow read: if canReadStudentRecord(resource.data.studentId);

      // Students cannot create evaluations
      // Only trusted execution service (via admin SDK or service account) can create
      allow create: if false;

      // Evaluations are immutable once created
      allow update, delete: if false;
    }

    // ============================================================================
    // CODING ACTIVITY PROGRESS
    // ============================================================================
    // Only the trusted execution service can authoritatively update progress.
    // Students can read their own progress but cannot modify it.
    match /coding_activity_progress/{progressId} {
      allow read: if canReadStudentRecord(resource.data.studentId);

      // Students cannot create or update progress authoritatively
      // Only trusted execution service (via admin SDK or service account) can update
      allow create, update, delete: if false;
    }

    // ============================================================================
    // PRIVATE CHALLENGE CONFIGURATION
    // ============================================================================
    // Private test cases and reference solutions are accessible only to teachers.
    // Students must never access this collection.
    match /private_challenge_config/{configId} {
      allow read: if isTeacher();
      allow create, update, delete: if isTeacher();
    }

    // ============================================================================
    // COURSE PACKAGES
    // ============================================================================
    // Students may browse active packages for their own grade. Previously owned
    // packages remain readable after deactivation through the ownership record.
    match /coursePackages/{packageId} {
      allow read: if isTeacher()
        || (isActiveLearner()
          && resource.data.gradeLevel == currentUser().data.gradeLevel
          && (resource.data.isActive == true || hasPackageOwnership(packageId)));

      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // ============================================================================
    // STUDENT PACKAGE ACCESS
    // ============================================================================
    // Permanent package ownership is stored here after a valid access code is redeemed.
    match /studentPackageAccess/{accessId} {
      allow read: if isTeacher()
        || (isStudent() && resource.data.studentId == request.auth.uid);

      allow create: if isStudent()
        && currentUser().data.status == 'active'
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.packageId is string
        && request.resource.data.codeId is string
        && request.resource.data.status == 'active'
        && request.resource.data.activatedAt is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && getAfter(/databases/$(database)/documents/packageAccessCodes/$(request.resource.data.codeId)).data.usedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/packageAccessCodes/$(request.resource.data.codeId)).data.packageId == request.resource.data.packageId
        && getAfter(/databases/$(database)/documents/packageAccessCodes/$(request.resource.data.codeId)).data.active == false;

      allow update: if isTeacher()
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.packageId == resource.data.packageId
        && (request.resource.data.status == 'active'
          || packageEntitlementRemovedAfterWrite(resource.data.studentId, resource.data.packageId));
      allow delete: if isTeacher()
        && packageEntitlementRemovedAfterWrite(resource.data.studentId, resource.data.packageId);
    }

    // ============================================================================
    // PACKAGE ACCESS CODES
    // ============================================================================
    // Teachers can create and read all access codes.
    // Students can only redeem codes via transaction (no direct write access).
    match /packageAccessCodes/{codeId} {
      allow read: if isTeacher()
        || (isStudent() && resource.data.code == codeId);

      allow create: if isTeacher();
      allow update: if isStudent()
        && currentUser().data.status == 'active'
        && resource.data.active == true
        && resource.data.code == codeId
        && request.resource.data.active == false
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'usedBy', 'usedAt', 'status', 'updatedAt'])
        && request.resource.data.packageId == resource.data.packageId
        && request.resource.data.code == resource.data.code
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastRedeemedAccessCode == codeId
        && resource.data.packageId in getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.accessiblePackageIds;
      allow delete: if isTeacher();
    }

    // Deny every collection/document not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
